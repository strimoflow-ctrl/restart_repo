async def process_task_item(index, item_type, link, safe_lec_name, caption, thread_id, course_key, item_hash, user_client, bot_client, target_group):
    global DONE_COUNT, FAIL_COUNT, CURRENT_FILE_NAME, CURRENT_ACTION, PROMO_COUNTER, current_upload_index
    
    file_ext = ".mp4" if item_type == "video" else ".pdf"
    is_video = (item_type == "video")
    local_path = f"{index}_{safe_lec_name}{file_ext}"

    # Ensure disk space does not exceed limits by forcing a strict sliding window of 4 active items
    async with window_condition:
        while index > current_upload_index + 3:
            await window_condition.wait()

    # Wait for a free download slot (Max N concurrent downloads)
    async with download_slot_lock:
        while is_paused: await asyncio.sleep(2)
        if stop_requested: return
        
        try:
            await download_file(link, local_path, bot_client, course_key)
            if is_video and os.path.exists(local_path):
                file_size = os.path.getsize(local_path)
                if file_size > 2 * 1024 * 1024 * 1024:
                    duration, _, _ = get_video_metadata(local_path)
                    compressed_path = f"comp_{local_path}"
                    compress_video(local_path, compressed_path, duration or 3600, bot_client, course_key)
                    os.remove(local_path)
                    os.rename(compressed_path, local_path)
        except Exception as e:
            print(f"❌ Download failed for {safe_lec_name}: {e}")
            if os.path.exists(local_path): os.remove(local_path)

    # Wait for EXACT TURN to upload strictly chronologically
    async with upload_condition:
        while current_upload_index != index:
            await upload_condition.wait()
            
        while is_paused: await asyncio.sleep(2)
        if stop_requested: return

        if os.path.exists(local_path):
            global CURRENT_FILE_NAME, CURRENT_FILE_SIZE
            CURRENT_FILE_NAME = f"{safe_lec_name}{file_ext}"
            file_sz = os.path.getsize(local_path)
            if file_sz < 1024 * 1024 * 1024:
                CURRENT_FILE_SIZE = f"{file_sz / (1024*1024):.1f} MB"
            else:
                CURRENT_FILE_SIZE = f"{file_sz / (1024*1024*1024):.2f} GB"
                
            try:
                await upload_file_with_progress(
                    user_client, bot_client, target_group, local_path, thread_id, caption, course_key, is_video=is_video
                )
                mark_as_done(course_key, item_hash)
                DONE_COUNT += 1
                PROMO_COUNTER += 1
                
                # Send Promo
                if PROMO_COUNTER >= 10:
                    promo_msg = "╔══════════════╗\n🎓 𝑨𝒍𝒍 𝑳𝒆𝒄𝒕𝒖𝒓𝒆𝒔 𝑨𝒗𝒂𝒊𝒍𝒂𝒃𝒍𝒆 🎓\n╚══════════════╝\n\n📌 𝑱𝒐𝒊𝒏 𝑨𝒍𝒍 𝑪𝒉𝒂𝒏𝒏𝒆𝒍𝒔 & 𝑮𝒓𝒐𝒖𝒑𝒔\n\n➊ https://t.me/nainoacademy\n\n➋ https://t.me/nainoneet\n\n➌ https://t.me/+PxRco8uPq95kYjNl\n\n✨ 𝑱𝒐𝒊𝒏 𝑵𝒐𝒘 & 𝑮𝒆𝒕 𝑨𝒄𝒄𝒆𝒔𝒔 𝒕𝒐 𝑨𝒍𝒍 𝑳𝒆𝒄𝒕𝒖𝒓𝒆𝒔 ✨"
                    try:
                        await user_client.send_message(target_group, promo_msg, reply_to=thread_id)
                    except Exception:
                        pass
                    PROMO_COUNTER = 0

            except Exception as e:
                err_msg = str(e).lower()
                if any(x in err_msg for x in ["auth", "session", "key", "banned", "revoked", "unregistered"]):
                    CURRENT_ACTION = f"CRITICAL SESSION ERROR: {e}"
                    await update_status_dashboard(bot_client, course_key, force=True)
                    print(f"❌ Critical Session Error encountered: {e}. Exiting immediately to prevent data corruption!")
                    sys.exit(1)
                    
                FAIL_COUNT += 1
                CURRENT_ACTION = f"Upload failed: {e}"
                await update_status_dashboard(bot_client, course_key, force=True)
                await asyncio.sleep(3)
            finally:
                if os.path.exists(local_path):
                    os.remove(local_path)
        else:
            FAIL_COUNT += 1

        # Turn is complete! Wake up the next index!
        current_upload_index += 1
        upload_condition.notify_all()
        
    async with window_condition:
        window_condition.notify_all()
        
    check_auto_restart()

