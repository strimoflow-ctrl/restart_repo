        try:
            url = f"{FIREBASE_DB_URL}/{FIREBASE_FOLDER}/control/command.json"
            res = requests.get(url, timeout=5)
            cmd = res.json()
            if cmd == "pause":
                is_paused = True
            elif cmd == "resume":
                is_paused = False
                requests.put(url, json="running")
            elif cmd == "stop":
                stop_requested = True
            elif cmd == "restart":
                sys.exit(0)
        except Exception:
            pass
        await asyncio.sleep(5)

