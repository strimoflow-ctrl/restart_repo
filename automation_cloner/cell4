    global KAGGLE_USERNAME, KAGGLE_KEY, KAGGLE_SLUG, SERVER_URL, current_upload_index

    # Start Control Command loop
    asyncio.create_task(check_command_loop())
    
    print("⏳ Syncing configs from Firebase...")
    try:
        url = f"{FIREBASE_DB_URL}/{FIREBASE_FOLDER}/config.json"
        res = requests.get(url, timeout=10)
        config_data = res.json()
        if config_data:
            API_ID = config_data.get("api_id", "")
            API_HASH = config_data.get("api_hash", "")
            SESSION_STRING = config_data.get("session_string", "")
            BOT_TOKEN = config_data.get("bot_token", "")
            OWNER_CHAT_ID = config_data.get("owner_chat_id", "")
            branding_text = config_data.get("extracted_by", branding_text)
            SERVER_URL = config_data.get("server_url", "")
    except Exception:
        pass

    if not API_ID or not BOT_TOKEN:
        print("❌ Essential config missing from Firebase. Halting.")
        return

    print("⏳ Fetching active catalog from Firebase...")
    catalog = []
    try:
        url = f"{FIREBASE_DB_URL}/{FIREBASE_FOLDER}/catalog.json"
        res = requests.get(url, timeout=15)
        catalog = res.json()
    except Exception:
        pass

    if not catalog:
        print("❌ Failed to load catalog from Firebase!")
        return

    # Check ACTIVE_COURSE_KEY
    target_courses = []
    if ACTIVE_COURSE_KEY == "all":
        target_courses = catalog
    else:
        for item in catalog:
            if item.get("local_file", "").replace(".json", "").replace(".", "_") == ACTIVE_COURSE_KEY.replace(".", "_"):
                target_courses = [item]
                break

    if not target_courses:
        print(f"❌ No active courses found matching key: '{ACTIVE_COURSE_KEY}'!")
        return

    # Initialize Telethon Clients
    clean_session = SESSION_STRING.strip().strip('"').strip("'").replace("\ufeff", "").replace(" ", "")
    clean_session = "".join(c for c in clean_session if c.isalnum() or c in "-_=")
    
    try:
        user_client = TelegramClient(StringSession(clean_session), API_ID, API_HASH)
        bot_client = TelegramClient(MemorySession(), API_ID, API_HASH)
        await user_client.start()
        await bot_client.start(bot_token=BOT_TOKEN)
        print("✅ Authorized successfully!")
    except Exception as e:
        print(f"❌ Session login failed: {e}")
        return

    # Process all selected courses
    for course in target_courses:
        if stop_requested: break
        
        course_title = course.get("title")
        target_group_name = course.get("group_name")
        thumbnail_url = course.get("thumbnail")
        local_filename = course.get("local_file")
        course_key = local_filename.replace(".json", "").replace(".", "_")

        status = get_course_status(course_key)
        if status == "completed":
            print(f"ℹ️ Skipping '{course_title}' (Already cloned fully).")
            continue

        set_course_status(course_key, "processing")
        
        if os.path.exists("thumbnail.jpg"): os.remove("thumbnail.jpg")
        if thumbnail_url:
            try:
                res = requests.get(thumbnail_url, timeout=15)
                if res.status_code == 200:
                    with open("thumbnail_raw.jpg", "wb") as f: f.write(res.content)
                    img = Image.open("thumbnail_raw.jpg")
                    if img.mode != "RGB": img = img.convert("RGB")
                    img.thumbnail((320, 320))
                    img.save("thumbnail.jpg", "JPEG", quality=90)
                    os.remove("thumbnail_raw.jpg")
            except Exception:
                pass

        lectures_data = None
        try:
            url = f"{FIREBASE_DB_URL}/{FIREBASE_FOLDER}/courses/{course_key}.json"
            res = requests.get(url, timeout=15)
            lectures_data = res.json()
        except Exception:
            pass

        if not lectures_data or "subjects" not in lectures_data:
            print(f"❌ Invalid format in course '{course_title}'! Skipping...")
            continue

        # Build task list to flatten structure
        tasks_list = []
        
        # 1. First establish forum megagroup
        target_group_name = course.get("group_name", course_title).replace(" - Cloner", "").strip()
        group_id = get_saved_group_id(course_key)
        if not group_id:
            while True:
                try:
                    create_res = await user_client(CreateChannelRequest(
                        title=target_group_name, about=f"Lectures for {course_title}.", megagroup=True
                    ))
                    new_channel = create_res.chats[0]
                    group_id = int(f"-100{new_channel.id}")
                    await user_client(ToggleForumRequest(channel=new_channel, enabled=True, tabs=False))
                    save_group_id(course_key, group_id)
                    await asyncio.sleep(10)
                    break
                except FloodWaitError as e:
                    await asyncio.sleep(e.seconds + 2)
                except Exception as e:
                    group_id = None
                    break
            if not group_id: continue

        try:
            target_group = await user_client.get_entity(group_id)
        except Exception:
            continue

        # 2. Iterate and append to tasks_list
        for sub in lectures_data["subjects"]:
            if "chapters" not in sub: continue
            for chapter in sub["chapters"]:
                chapter_name = chapter.get("chapter") or chapter.get("name") or chapter.get("title") or "Unnamed Chapter"
                chapter_hash = get_md5_hash(chapter_name)
                
                thread_id = get_saved_topic_id(course_key, chapter_hash)
                if not thread_id:
                    while True:
                        try:
                            result = await user_client(CreateForumTopicRequest(peer=target_group, title=chapter_name))
                            for update in result.updates:
                                if hasattr(update, 'message'):
                                    thread_id = update.message.id
                                    break
                            if not thread_id: thread_id = result.updates[0].id
                            save_topic_id(course_key, chapter_hash, thread_id)
                            await asyncio.sleep(5)
                            break
                        except FloodWaitError as e:
                            await asyncio.sleep(e.seconds + 2)
                        except Exception:
                            thread_id = None
                            break
                    if not thread_id: continue

                if "lectures" not in chapter: continue
                for lecture in chapter["lectures"]:
                    lec_name = lecture["name"]
                    safe_lec_name = sanitize_filename(lec_name)
                    stylish_lec_name = to_stylish_bold(lec_name)
                    stylish_chapter_name = to_stylish_bold(chapter_name)
                    
                    for l_type, l_link in [("video", lecture.get("link")), ("notes", lecture.get("notes")), ("dpp", lecture.get("dpp"))]:
                        if l_link:
                            item_hash = get_md5_hash(chapter_name + lec_name + l_type + l_link)
                            if check_if_done(course_key, item_hash):
                                DONE_COUNT += 1
                                continue
                            
                            icon = "🎬 **𝗩𝗶𝗱𝗲𝗼 𝗟𝗲𝗰𝘁𝘂𝗿𝗲:**" if l_type == "video" else ("📚 **𝗟𝗲𝗰𝘁𝘂𝗿𝗲 𝗡𝗼𝘁𝗲𝘀:**" if l_type == "notes" else "📝 **𝗗𝗣𝗣:**")
                            caption = f"{icon} {stylish_lec_name}\n📁 **𝗖𝗵𝗮𝗽𝘁𝗲𝗿:** {stylish_chapter_name}\n\n⚡ **𝗘𝘅𝘁𝗿𝗮𝗰𝘁𝗲𝗱 𝗯𝘆 {branding_text}**"
                            
                            tasks_list.append({
                                'type': l_type,
                                'link': l_link,
                                'safe_name': f"{safe_lec_name} - {l_type.upper()}",
                                'caption': caption,
                                'thread_id': thread_id,
                                'course_key': course_key,
                                'hash': item_hash
                            })

        TOTAL_FILES = DONE_COUNT + len(tasks_list)
        
        # 3. Execute tasks concurrently with strict order
        current_upload_index = 0
        async_tasks = []
        for i, task_data in enumerate(tasks_list):
            async_tasks.append(asyncio.create_task(
                process_task_item(
                    index=i,
                    item_type=task_data['type'],
                    link=task_data['link'],
                    safe_lec_name=task_data['safe_name'],
                    caption=task_data['caption'],
                    thread_id=task_data['thread_id'],
                    course_key=task_data['course_key'],
                    item_hash=task_data['hash'],
                    user_client=user_client,
                    bot_client=bot_client,
                    target_group=target_group
                )
            ))
            
        await asyncio.gather(*async_tasks)
        if stop_requested: break
        
        set_course_status(course_key, "completed")

    CURRENT_ACTION = "Process Completed! 🎉" if not stop_requested else "Stopped by User."
    PROGRESS_PCT = 100.0
    await update_status_dashboard(bot_client, "all", force=True)
    await user_client.disconnect()
    await bot_client.disconnect()

try:
    import asyncio
    asyncio.run(start_automation())
except RuntimeError:
    import asyncio
    import nest_asyncio
    nest_asyncio.apply()
    asyncio.get_event_loop().run_until_complete(start_automation())
